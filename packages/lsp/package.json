{
  "name": "@kidkender/archmind-lsp",
  "version": "0.1.2",
  "description": "ArchMind Language Server — inlay hints and diagnostics for Laravel and NestJS in any LSP-compatible editor",
  "type": "module",
  "bin": {
    "archmind-lsp": "./dist/lsp.cjs"
  },
  "scripts": {
    "build": "node build.mjs",
    "dev": "node --loader ts-node/esm src/server.ts"
  },
  "dependencies": {
    "tree-sitter": "^0.21.0",
    "tree-sitter-php": "^0.23.0",
    "ts-morph": "^23.0.0"
  },
  "devDependencies": {
    "@archmind/laravel-parser": "*",
    "@archmind/nestjs-parser": "*",
    "@archmind/protocol": "*",
    "@types/node": "^20.0.0",
    "esbuild": "^0.28.0",
    "typescript": "^5.4.0",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.11"
  },
  "keywords": [
    "laravel",
    "nestjs",
    "lsp",
    "language-server",
    "inlay-hints",
    "archmind"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kidkender/archmind.git"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist/lsp.cjs",
    "README.md"
  ]
}
