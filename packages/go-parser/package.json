{
  "name": "@kidkender/archmind-go-parser",
  "version": "0.1.1",
  "description": "Static analysis parser for Go/Gin projects — extracts routes, middleware chains (including runtime skip-lists), and auth patterns into ArchMind IR graphs.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "keywords": [
    "archmind",
    "go",
    "golang",
    "gin",
    "parser",
    "static-analysis"
  ],
  "license": "MIT",
  "homepage": "https://github.com/Architecture-Mind/ArchMind#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Architecture-Mind/ArchMind",
    "directory": "packages/go-parser"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "node --experimental-vm-modules ../../node_modules/jest/bin/jest.js"
  },
  "dependencies": {
    "@kidkender/archmind-protocol": "^0.5.0",
    "tree-sitter": "^0.25.0",
    "tree-sitter-go": "^0.25.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "jest": "^29.0.0",
    "ts-jest": "^29.0.0",
    "typescript": "^5.4.0"
  }
}
