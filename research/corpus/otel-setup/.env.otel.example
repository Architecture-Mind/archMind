# ArchMind OTLP instrumentation — add these vars to the corpus app's .env
#
# Start the collector first:
#   node scripts/otlp-collector.mjs
#
# Then start the Laravel app with these vars set.

OTEL_ENABLED=true
OTEL_SERVICE_NAME=laravel-io          # change to "crater" for crater repo
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
