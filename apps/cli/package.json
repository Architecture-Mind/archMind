{
  "name": "@kidkender/archmind",
  "version": "0.8.0",
  "description": "Execution topology intelligence for Laravel, NestJS, and Go/Gin — trace routes, detect regressions, find security gaps. No LLM required.",
  "type": "module",
  "bin": {
    "archmind": "./dist/index.cjs"
  },
  "scripts": {
    "build": "node build.mjs",
    "dev": "tsc --watch",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "tree-sitter": "^0.21.0",
    "tree-sitter-php": "^0.22.0"
  },
  "devDependencies": {
    "@kidkender/archmind-explainer": "*",
    "@kidkender/archmind-laravel-parser": "*",
    "@kidkender/archmind-llm-client": "*",
    "@kidkender/archmind-nestjs-parser": "*",
    "@kidkender/archmind-go-parser": "*",
    "@kidkender/archmind-orchestrator": "*",
    "@kidkender/archmind-protocol": "*",
    "@kidkender/archmind-retrieval": "*",
    "@kidkender/archmind-scorer": "*",
    "@types/node": "^20.0.0",
    "esbuild": "^0.28.0",
    "typescript": "^5.4.0"
  },
  "keywords": [
    "laravel",
    "static-analysis",
    "security",
    "cli",
    "execution-graph"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kidkender/archmind"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/index.cjs",
    "CHANGELOG.md",
    "README.md"
  ]
}
